{
  "name": "anaemia",
  "version": "1.0.0",
  "private": true,
  "description": "a high-performance SolidJS SSR framework built for large projects",
  "keywords": [
    "rspack",
    "solidjs",
    "ssr"
  ],
  "license": "ISC",
  "author": "colourlabs",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @anaemia/* --filter !@anaemia/template-base build",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--test-reporter=spec' pnpm -r --if-present test && pnpm -r --if-present test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "pnpm -r exec rm -rf dist .rspack node_modules",
    "check:unused": "knip",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js --patch",
    "release:dry": "node scripts/release.js --dry-run",
    "release:patch:dry": "node scripts/release.js --patch --dry-run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "knip": "^6.14.2",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.52.0",
    "simple-git-hooks": "^2.13.1",
    "solid-js": "^1.9.13",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,scss,css}": "oxfmt --write",
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.5.2"
}
