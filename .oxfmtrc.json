{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "printWidth": 120,
  "tabWidth": 2,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.anaemia",
    // babel-transform-server makes the formatter hang for 250+ seconds due to the AST manipulation being deeply nested.
    "packages/bundler/src/plugins/babel-transform-server.ts"
  ]
}
