{
  "name": "@anaemia/bundler",
  "version": "0.9.0",
  "description": "bundler configurations and AST analyzerq",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analyzer": {
      "types": "./dist/analyzer/index.d.ts",
      "default": "./dist/analyzer/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@anaemia/core": "workspace:*",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rspack/core": "^2.2.3",
    "babel-loader": "^10.1.1",
    "babel-preset-solid": "^1.9.12",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.133.0",
    "picocolors": "^1.1.1",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.0",
    "solid-refresh": "^0.7.8",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5"
  }
