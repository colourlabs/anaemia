{
  "name": "@anaemia/plugin-mdx",
  "version": "0.9.0",
  "description": "MDX support for anaemia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:integration": "pnpm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "playwright": "^1.60.0"
  },
  "peerDependencies": {
    "@anaemia/core": "workspace:*",
    "@rspack/core": "*",
    "solid-js": "^1.9.13"
  }
}
